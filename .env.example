# supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# digitalocean spaces config
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=

# ai keys
GEMINI_API_KEY=
OPENAI_API_KEY=

# google cloud vertex ai config
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=
# Path to GCP service account JSON file
# Local dev: use absolute path to your service account file
# Docker/VPS: use /app/gcp-service-account.json (mounted via volume)
GOOGLE_CLOUD_CREDENTIALS_PATH=/app/gcp-service-account.json

# Docker Compose: Path to service account file on host machine (for volume mount)
# VPS: /home/vitor/apps/secrets/vibe-engine-v2/gcp-service-account.json
# Local: /path/to/your/service-account.json
GCP_SERVICE_ACCOUNT_FILE=/home/vitor/apps/secrets/vibe-engine-v2/gcp-service-account.json
